# # Port gateway yang akan di-expose ngrok
# GATEWAY_PORT=5000

# # Backend pool (laptop user). Bisa satu atau banyak, pisahkan dengan koma.
# # Contoh 1 node:
# BACKEND_TARGETS=http://localhost:5005
# # Contoh 2 node:
# # BACKEND_TARGETS=http://192.168.1.10:3001,http://192.168.1.10:3002

# # Comment service (laptop admin)
# COMMENT_SERVICE=http://192.168.1.11:4001

# # Media static service (laptop admin)
# MEDIA_SERVICE=http://192.168.1.11:4002

# # Timeout biar kalau service mati, demo-nya dramatis tapi tidak menggantung selamanya
# PROXY_TIMEOUT_MS=4000

GATEWAY_PORT=2000

BACKEND_TARGETS=http://localhost:5005,http://localhost:5010
COMMENT_SERVICE=http://localhost:4001

